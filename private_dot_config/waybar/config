{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/moon", "mpris", "cpu", "memory", "disk", "network", "pulseaudio", "bluetooth", "battery", "tray"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": true
  },
  "hyprland/submap": {
    "format": "[{name}]",
    "tooltip": false
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 70,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}\nWeek {:%V}"
  },
  "custom/moon": {
    "exec": "$HOME/.local/bin/pm-moon",
    "return-type": "json",
    "interval": 3600,
    "format": "{}",
    "tooltip": true
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": { "default": "♫", "spotify": "", "firefox": "" },
    "status-icons": { "paused": "⏸", "stopped": "■" },
    "dynamic-len": 30,
    "tooltip-format": "{player} · {status}\n{artist} — {title}",
    "on-click": "play-pause",
    "on-click-middle": "previous track",
    "on-click-right": "next track",
    "max-length": 40
  },
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 5,
    "format": "RAM {percentage}%",
    "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB"
  },
  "disk": {
    "interval": 30,
    "path": "/",
    "format": "Disk {percentage_used}%",
    "tooltip-format": "Root: {used} / {total}"
  },
  "network": {
    "interval": 5,
    "format-wifi": "Wi-Fi {signalStrength}%",
    "format-ethernet": "LAN {ipaddr}",
    "format-disconnected": "Offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "scroll-step": 1,
    "format": "Audio {volume}%",
    "format-muted": "Audio muted",
    "on-click": "pavucontrol"
  },
  "bluetooth": {
    "format": "BT {status}",
    "format-connected": "BT {num_connections}",
    "format-disabled": "",
    "tooltip-format": "{device_alias}"
  },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "Battery {capacity}%",
    "format-charging": "Charging {capacity}%",
    "format-plugged": "Plugged {capacity}%"
  },
  "tray": { "spacing": 8 }
}
