#!/usr/bin/env bash
set -euo pipefail

choose() {
  local prompt="$1"
  local lines="$2"
  shift 2
  printf '%s\n' "$@" | fuzzel --dmenu --prompt="$prompt" --lines="$lines" --width=32
}

confirm() {
  local label="$1"
  local answer
  answer="$(choose "Confirma > " 2 "Cancel·la" "$label")" || return 1
  [[ "$answer" == "$label" ]]
}

choice="$(choose "Energia > " 5 \
  "Bloqueja la pantalla" \
  "Suspèn" \
  "Reinicia…" \
  "Apaga l'ordinador…" \
  "Cancel·la")" || exit 0

case "$choice" in
  "Bloqueja la pantalla") exec hyprlock ;;
  "Suspèn") exec systemctl suspend ;;
  "Reinicia…")
    if ! confirm "Sí, reinicia"; then exit 0; fi
    exec systemctl reboot
    ;;
  "Apaga l'ordinador…")
    if ! confirm "Sí, apaga l'ordinador"; then exit 0; fi
    exec systemctl poweroff
    ;;
  *) exit 0 ;;
esac
